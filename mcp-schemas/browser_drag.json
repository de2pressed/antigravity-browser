{
  "name": "browser_drag",
  "description": "Drag from a source element/coordinates to a target element/coordinates with animated cursor.",
  "parameters": {
    "type": "object",
    "properties": {
      "tabId": {
        "type": "integer",
        "description": "The ID of the target tab.",
        "minimum": 1
      },
      "fromUid": {
        "type": "string",
        "description": "Source element UID."
      },
      "fromX": {
        "type": "number",
        "description": "Source X coordinate."
      },
      "fromY": {
        "type": "number",
        "description": "Source Y coordinate."
      },
      "toUid": {
        "type": "string",
        "description": "Destination element UID."
      },
      "toX": {
        "type": "number",
        "description": "Destination X coordinate."
      },
      "toY": {
        "type": "number",
        "description": "Destination Y coordinate."
      },
      "steps": {
        "type": "number",
        "description": "Number of intermediate drag steps. Defaults to 10."
      }
    },
    "required": [
      "tabId"
    ]
  }
}
