{
  "name": "browser_reload_tab",
  "description": "Reload an existing tab with optional cache bypass.",
  "parameters": {
    "type": "object",
    "properties": {
      "tabId": {
        "type": "integer",
        "description": "The ID of the tab to reload.",
        "minimum": 1
      },
      "ignoreCache": {
        "type": "boolean",
        "description": "Whether to bypass browser cache."
      }
    },
    "required": [
      "tabId"
    ]
  }
}
