{
  "manifest_version": 3,
  "name": "Antigravity Browser Bridge",
  "version": "1.6.0",
  "description": "High-precision enterprise-grade browser bridge for Antigravity AI pair programmer.",
  "key": "",
  "permissions": [
    "tabs",
    "debugger",
    "scripting",
    "activeTab",
    "nativeMessaging",
    "storage",
    "webNavigation",
    "cookies",
    "identity",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["images/cursor.png"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Antigravity Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
